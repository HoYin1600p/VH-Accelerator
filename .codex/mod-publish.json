{
  "schemaVersion": 1,
  "workflow": {
    "skill": "publish-mod-update",
    "revision": 5
  },
  "modName": "VH Accelerator",
  "releaseLedger": "docs/release-ledger.json",
  "version": {
    "sourceFiles": ["gradle.properties"],
    "property": "mod_version",
    "tagPrefix": "v"
  },
  "build": {
    "testCommand": ".\\gradlew.bat check",
    "buildCommand": ".\\gradlew.bat clean build",
    "artifactGlob": "build/libs/*.jar",
    "excludeGlobs": ["*-sources.jar", "*-dev.jar", "*-shadow.jar"]
  },
  "github": {
    "repository": "HoYin1600p/VH-Accelerator",
    "defaultBranch": "master",
    "versionTrackingJson": "update.json",
    "versionTrackingProductionUrl": "https://raw.githubusercontent.com/HoYin1600p/VH-Accelerator/master/update.json",
    "versionTrackingPointers": {
      "version": "/promos/1.18.2-latest",
      "critical": null,
      "message": "/1.18.2/{version}",
      "removeMessageWhenNull": true
    }
  },
  "curseforge": {
    "projectId": "1629601",
    "projectSlug": "vh-accelerator",
    "uploadCommand": ".\\scripts\\Publish-CurseForge.ps1",
    "uploadDryRunCommand": ".\\scripts\\Publish-CurseForge.ps1 -DryRun",
    "catalogValidationCommand": ".\\scripts\\Test-CurseForgeGameVersions.ps1",
    "gameVersionIds": ["9008", "8326", "7498", "9638"],
    "requiredGameVersionTypes": [
      {"name": "Minecraft 1.18", "id": "73250"},
      {"name": "Java", "id": "2"},
      {"name": "Modloader", "id": "68441"},
      {"name": "Environment", "id": "75208"}
    ],
    "descriptionFile": "docs/curseforge/DESCRIPTION.md",
    "descriptionFormat": "markdown",
    "releaseChannel": "release",
    "approvalPollMinutes": 15,
    "manualRelease": false
  },
  "compatibility": {
    "gameVersionSources": ["gradle.properties", "docs/COMPATIBILITY_BASELINE.md"],
    "loaderSources": ["src/main/resources/META-INF/mods.toml"]
  },
  "identity": {
    "scanCommand": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/Verify-PublicIdentity.ps1",
    "scanLog": "external-shadow-workspace/identity-scan/identity-scan-log.md"
  },
  "automation": {
    "approvalMonitor": {
      "enabled": false,
      "workflowFile": ".github/workflows/curseforge-approval-monitor.yml",
      "command": "python scripts/curseforge_approval_monitor.py",
      "selfTestCommand": "python scripts/curseforge_approval_monitor.py --self-test",
      "verificationMode": "public-file-page",
      "publicFileUrlTemplate": "https://www.curseforge.com/minecraft/mc-mods/{projectSlug}/files/{fileId}",
      "scheduleMinutes": 15,
      "attentionAfterHours": 72,
      "activationMode": "direct-push"
    }
  }
}
